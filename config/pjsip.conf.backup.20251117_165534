[global]
max_forwards=70
user_agent=Asterisk PBX
default_realm=asterisk.local

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
local_net=192.168.100.0/24
local_net=172.20.10.0/24
local_net=192.168.137.0/24
external_media_address=192.168.100.34
external_signaling_address=192.168.100.34

;=== User 1001 - Laptop ===
[1001]
type=endpoint
context=internal
disallow=all
allow=ulaw
allow=alaw
allow=gsm
auth=auth1001
aors=1001
callerid="Laptop" <1001>
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[auth1001]
type=auth
auth_type=userpass
username=1001
password=pass1001

[1001]
type=aor
max_contacts=1
remove_existing=yes

